# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/accountix?schema=public"

# Optional AI integration; credentials must remain server-side only.
AI_PROVIDER=""
AI_API_KEY=""

# Optional payment integration; no card data should ever be stored by this app.
PAYMENT_PROVIDER=""
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Generate a random secret of at least 32 characters for signed sessions
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Comma-separated login email addresses allowed to review platform-wide bank transfers.
ADMIN_EMAILS="admin@example.com"

# Official subscription prices in MAD. Set these before enabling bank-transfer requests.
ACCOUNTIX_PRICE_PREMIUM_MONTHLY_MAD=""
ACCOUNTIX_PRICE_PREMIUM_ANNUAL_MAD=""
ACCOUNTIX_PRICE_ENTERPRISE_MONTHLY_MAD=""
ACCOUNTIX_PRICE_ENTERPRISE_ANNUAL_MAD=""
